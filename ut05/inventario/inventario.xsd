<?xml version="1.0" encoding="UTF-8"?>
<!-- inventario.xsd · Esquema del inventario de equipos de red del aula · Práctica 05, Fase 5 -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Identificador del equipo: EQ- y dos cifras -->
  <xs:simpleType name="tipoId">
    <xs:restriction base="xs:string">
      <xs:pattern value="EQ-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Tipo de equipo: lista cerrada -->
  <xs:simpleType name="tipoEquipo">
    <xs:restriction base="xs:string">
      <xs:enumeration value="router"/>
      <xs:enumeration value="switch"/>
      <xs:enumeration value="punto-acceso"/>
      <xs:enumeration value="servidor"/>
      <xs:enumeration value="impresora"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- IPv4: cuatro números de 0 a 255 separados por puntos -->
  <xs:simpleType name="tipoIPv4">
    <xs:restriction base="xs:string">
      <xs:pattern value="((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- MAC: seis parejas hexadecimales separadas por dos puntos -->
  <xs:simpleType name="tipoMAC">
    <xs:restriction base="xs:string">
      <xs:pattern value="([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Ubicación: texto con un atributo opcional para el armario -->
  <xs:complexType name="tipoUbicacion">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="armario" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="tipoEquipoRed">
    <xs:sequence>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="modelo" type="xs:string"/>
      <xs:element name="ip" type="tipoIPv4"/>
      <xs:element name="mac" type="tipoMAC"/>
      <xs:element name="ubicacion" type="tipoUbicacion"/>
      <xs:element name="fecha_compra" type="xs:date"/>
    </xs:sequence>
    <xs:attribute name="id" type="tipoId" use="required"/>
    <xs:attribute name="tipo" type="tipoEquipo" use="required"/>
  </xs:complexType>

  <xs:element name="inventario">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="equipo" type="tipoEquipoRed" minOccurs="5" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="aula" type="xs:string" use="required"/>
      <xs:attribute name="actualizado" type="xs:date" use="required"/>
    </xs:complexType>
    <!-- Ni el id, ni la IP, ni la MAC se pueden repetir -->
    <xs:unique name="idUnico"><xs:selector xpath="equipo"/><xs:field xpath="@id"/></xs:unique>
    <xs:unique name="ipUnica"><xs:selector xpath="equipo"/><xs:field xpath="ip"/></xs:unique>
    <xs:unique name="macUnica"><xs:selector xpath="equipo"/><xs:field xpath="mac"/></xs:unique>
  </xs:element>

</xs:schema>
